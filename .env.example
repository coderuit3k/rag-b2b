# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
# Chi tiết từng khoá: docs/README.md §Phụ thuộc mới.

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4-5

# LLM_BACKEND=ollama  -> llm_router + llm_main chạy local qua langchain_ollama.ChatOllama.
#                        cypher_llm vẫn gpt-4o; embeddings vẫn OpenAI.
LLM_BACKEND=cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# OLLAMA_NUM_CTX=4096      # hạ context nếu VRAM 6GB chật (mặc định: theo model)

# --- Neo4j AuraDB ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# NEO4J_DATABASE=7b348c80   # tùy chọn; mặc định fallback về NEO4J_USERNAME

# --- Qdrant Cloud ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# --- Neon Postgres (lịch sử chat, chat_store.py) ---
# Lấy tại https://console.neon.tech -> project -> Connection string (chọn nhánh "pooled connection")
DATABASE_URL=

# --- Neon Postgres RIÊNG cho dữ liệu vận hành (daily_audio_briefing.py, watcher.py, observability.py)
# — tách khỏi DATABASE_URL ở trên (đó là dữ liệu hội thoại người dùng thật) ---
DAILY_DATABASE_URL=

# --- LangSmith (trace chi tiết từng lời gọi LLM bên trong LangChain — prompt/completion/token,
# bổ sung CHO observability.py chứ không thay thế: chỉ thấy phần LangChain, không thấy các lời gọi
# API ngoài LangChain như Composio/Whisper/ElevenLabs) ---
# Lấy tại https://smith.langchain.com -> Settings -> API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-b2b

# --- AWS (S3 + Athena) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# --- Nhánh web ---
TAVILY_API_KEY=

# --- Voice AI (Tin nhắn thoại — tools/voice.py) ---
# OPENAI_API_KEY ở trên dùng chung cho Whisper (STT), không cần key riêng.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # mặc định "Sarah" nếu bỏ trống — lấy voice_id KHÁC
                                              # tại GET /v1/voices của chính tài khoản bạn (gói Free
                                              # chỉ gọi API được voice trong danh mục "premade" của
                                              # tài khoản, không dùng được "library voices")

# --- Báo cáo Âm thanh Hàng ngày (scripts/daily_audio_briefing.py, cron) ---
# Nhiều email cách nhau dấu phẩy — bỏ trống thì dùng mặc định RESULT_EMAIL_TO ở trên.
DAILY_BRIEFING_RECIPIENTS=

# --- Nhánh email (Composio Gmail + Cloudflare KV) ---
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=rag-b2b
RESULT_EMAIL_TO=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
